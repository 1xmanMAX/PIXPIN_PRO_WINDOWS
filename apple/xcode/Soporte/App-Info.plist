<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- El mismo que apple/app/Recursos/Info.plist (el de SwiftPM), con las
	     variables de Xcode y los tipos de los dibujos (para Quick Look). -->
	<key>CFBundleName</key><string>PixPin</string>
	<key>CFBundleDisplayName</key><string>PixPin</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>CFBundleDevelopmentRegion</key><string>es</string>
	<key>LSMinimumSystemVersion</key><string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>LSApplicationCategoryType</key><string>public.app-category.productivity</string>
	<!-- Vive en la barra de menus, como la bandeja de Windows: sin icono en el Dock. -->
	<key>LSUIElement</key><true/>
	<key>NSHighResolutionCapable</key><true/>
	<key>NSSupportsAutomaticTermination</key><false/>
	<key>NSLocalNetworkUsageDescription</key>
	<string>PixPin busca tus otros aparatos (PC y móvil) en tu Wi-Fi para sincronizar tus proyectos sin pasar por internet.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_pixpin._tcp</string>
		<string>_pixpinenvio._tcp</string>
		<string>_pixpinrecibe._tcp</string>
		<string>_pixpinchat._tcp</string>
	</array>
	<key>NSScreenCaptureUsageDescription</key>
	<string>PixPin captura la zona de la pantalla que eliges para copiarla, dejarla flotando o mandarla a un proyecto.</string>
	<key>NSMicrophoneUsageDescription</key>
	<string>PixPin graba notas de voz para tus proyectos.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>PixPin pasa tus notas de voz a texto en este Mac, sin enviarlas a internet.</string>
	<!-- El dibujo propio (.pixpin2d) es de PixPin; el .excalidraw, de Excalidraw. -->
	<key>UTExportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>io.github.1xmanmax.pixpin.dibujo</string>
			<key>UTTypeDescription</key><string>Dibujo de PixPin</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>pixpin2d</string>
				</array>
			</dict>
		</dict>
	</array>
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key><string>com.excalidraw.excalidraw</string>
			<key>UTTypeDescription</key><string>Dibujo de Excalidraw</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.json</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>excalidraw</string>
				</array>
				<key>public.mime-type</key>
				<array>
					<string>application/vnd.excalidraw+json</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
