{
  "manifest_version": 3,
  "name": "PinDesk",
  "version": "1.0.0",
  "description": "Manda a PinDesk lo que ves: texto a tareas, notas, chat o lecciones; imágenes a pines u OCR; la página entera al chat o al móvil.",
  "key": "",
  "minimum_chrome_version": "116",
  "background": {
    "service_worker": "fondo.js",
    "type": "module"
  },
  "permissions": [
    "contextMenus",
    "nativeMessaging",
    "activeTab",
    "scripting",
    "debugger",
    "notifications"
  ],
  "host_permissions": ["<all_urls>"],
  "action": {
    "default_title": "PinDesk (Alt+Mayús+P)",
    "default_popup": "menu.html",
    "default_icon": {
      "16": "iconos/pindesk.png",
      "32": "iconos/pindesk.png"
    }
  },
  "icons": {
    "16": "iconos/pindesk.png",
    "48": "iconos/pindesk.png",
    "128": "iconos/pindesk.png"
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+P" },
      "description": "Abrir el menú de PinDesk"
    }
  }
}
