<?xml version="1.0" encoding="utf-8"?>
<!--
  Paquete de IDENTIDAD de PixPin Max (MSIX "con ubicacion externa", o
  "sparse package"). No lleva el programa dentro: apunta a la carpeta donde ya
  esta instalado (%LOCALAPPDATA%\Programs\PixPinMax, la de instalar.ps1) y le
  da a pixpinmax.exe una identidad de paquete. Con ella Windows le deja:

  - aparecer en el panel COMPARTIR de otras apps (texto, enlaces, imagenes,
    ficheros) -> llega como activacion ShareTarget y va al chat
    (crates/pixpin-shell/src/compartido.rs);
  - poner verbos en el menu contextual de PRIMER NIVEL de Windows 11 para sus
    tipos de fichero (sin DLL dentro del Explorador);
  - notificaciones con la identidad del paquete.

  Editor, nombre y aplicacion tienen que ser IGUALES a los del elemento <msix>
  de apps/pixpin/pixpinmax.manifest, y el editor igual al sujeto del
  certificado que crea paquete-identidad.ps1. La version la pone el script.

  Pasos: docs/integraciones-windows.md
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap2="http://schemas.microsoft.com/appx/manifest/uap/windows10/2"
  xmlns:uap3="http://schemas.microsoft.com/appx/manifest/uap/windows10/3"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap2 uap3 uap10 rescap">

  <Identity
    Name="ForgePixPin.PixPinMax"
    Publisher="CN=PixPin Max Local"
    Version="0.1.0.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>PixPin Max</DisplayName>
    <PublisherDisplayName>PixPin Max</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <!-- El programa NO esta en el paquete: esta en la ubicacion externa. -->
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>

  <Dependencies>
    <!-- 19041 = Windows 10 2004, lo minimo para paquetes con ubicacion externa. -->
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.19041.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="es-es" />
  </Resources>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="unvirtualizedResources" />
  </Capabilities>

  <Applications>
    <Application
      Id="PixPinMax"
      Executable="pixpinmax.exe"
      uap10:TrustLevel="mediumIL"
      uap10:RuntimeBehavior="win32App">
      <!-- AppListEntry="none": el menu Inicio ya tiene el acceso directo de
           siempre; sin esto saldria PixPin dos veces. -->
      <uap:VisualElements
        DisplayName="PixPin Max"
        Description="PixPin Max"
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png"
        AppListEntry="none" />

      <Extensions>
        <!-- Compartir: lo que mandan otras apps va al chat. -->
        <uap:Extension Category="windows.shareTarget">
          <uap:ShareTarget Description="Guardar en PixPin">
            <uap:SupportedFileTypes>
              <uap:SupportsAnyFileType />
            </uap:SupportedFileTypes>
            <uap:DataFormat>Text</uap:DataFormat>
            <uap:DataFormat>URI</uap:DataFormat>
            <uap:DataFormat>WebLink</uap:DataFormat>
            <uap:DataFormat>Bitmap</uap:DataFormat>
            <uap:DataFormat>StorageItems</uap:DataFormat>
          </uap:ShareTarget>
        </uap:Extension>

        <!-- Menu contextual de primer nivel en Windows 11: verbos del paquete
             para lo que PixPin sabe abrir. No es una asociacion: no cambia
             que programa abre cada tipo, solo anade las dos entradas. -->
        <uap3:Extension Category="windows.fileTypeAssociation" Executable="pixpinmax.exe" EntryPoint="Windows.FullTrustApplication">
          <uap3:FileTypeAssociation Name="pixpinmax">
            <uap:DisplayName>PixPin Max</uap:DisplayName>
            <uap:SupportedFileTypes>
              <uap:FileType>.png</uap:FileType>
              <uap:FileType>.jpg</uap:FileType>
              <uap:FileType>.jpeg</uap:FileType>
              <uap:FileType>.bmp</uap:FileType>
              <uap:FileType>.gif</uap:FileType>
              <uap:FileType>.webp</uap:FileType>
              <uap:FileType>.pdf</uap:FileType>
              <uap:FileType>.docx</uap:FileType>
              <uap:FileType>.doc</uap:FileType>
              <uap:FileType>.xlsx</uap:FileType>
              <uap:FileType>.xls</uap:FileType>
              <uap:FileType>.csv</uap:FileType>
              <uap:FileType>.pptx</uap:FileType>
              <uap:FileType>.ppt</uap:FileType>
              <uap:FileType>.epub</uap:FileType>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.txt</uap:FileType>
              <uap:FileType>.dwg</uap:FileType>
              <uap:FileType>.dxf</uap:FileType>
              <uap:FileType>.ifc</uap:FileType>
              <uap:FileType>.mp3</uap:FileType>
              <uap:FileType>.m4a</uap:FileType>
              <uap:FileType>.wav</uap:FileType>
              <uap:FileType>.mp4</uap:FileType>
            </uap:SupportedFileTypes>
            <uap2:SupportedVerbs>
              <!-- Un fichero suelto a pixpinmax.exe = sacarlo como pin (lo de
                   siempre al abrir con PixPin). -->
              <uap3:Verb Id="pinear" Parameters="&quot;%1&quot;">Pinear con PixPin</uap3:Verb>
              <!-- Varios a la vez en UNA llamada (MultiSelectModel=Player). -->
              <uap3:Verb Id="alchat" Parameters="--al-chat &quot;%1&quot;" MultiSelectModel="Player">Enviar al chat de PixPin</uap3:Verb>
            </uap2:SupportedVerbs>
          </uap3:FileTypeAssociation>
        </uap3:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
